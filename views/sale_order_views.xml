<?xml version="1.0" encoding="utf-8"?>
<!-- Odoo 17+: invisible directo (attrs/states deprecados desde 17.0) -->
<odoo>

    <record id="view_order_form_deposit" model="ir.ui.view">
        <field name="name">sale.order.form.deposit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Bloque Acopio debajo del cliente -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_deposit"/>
                <field name="deposit_type" invisible="not is_deposit or deposit_contract_id"/>
                <field name="deposit_index_product_id" invisible="not is_deposit or deposit_contract_id or deposit_type != 'index_product'"/>
                <field name="deposit_contract_id" options="{'no_create': True}"
                       invisible="not is_deposit"
                       placeholder="Vacío = crear nuevo contrato desde esta orden"/>
            </xpath>
            <!-- Botón Aplicar Acopio: visible cuando hay contrato existente (consumir) y en borrador -->
            <xpath expr="//button[@name='action_confirm'][1]" position="before">
                <button name="action_apply_deposit" type="object"
                        string="Aplicar Acopio" class="btn-secondary"
                        invisible="not deposit_contract_id or state != 'draft'"/>
            </xpath>
        </field>
    </record>

</odoo>
