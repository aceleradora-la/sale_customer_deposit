<?xml version="1.0" encoding="utf-8"?>
<!-- Odoo 18/19: list (en lugar de tree), invisible directo (en lugar de attrs) -->
<odoo>

    <!-- List View: Contrato de Acopio -->
    <record id="view_deposit_contract_tree" model="ir.ui.view">
        <field name="name">deposit.contract.tree</field>
        <field name="model">deposit.contract</field>
        <field name="arch" type="xml">
            <list string="Contratos de Acopio" decoration-muted="state == 'cancelled'" decoration-success="state == 'closed'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="deposit_type"/>
                <field name="state"/>
                <field name="amount_total" optional="show"/>
                <field name="amount_remaining" optional="show"/>
                <field name="quantity_index" optional="hide"/>
                <field name="quantity_index_remaining" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View: Contrato de Acopio -->
    <record id="view_deposit_contract_form" model="ir.ui.view">
        <field name="name">deposit.contract.form</field>
        <field name="model">deposit.contract</field>
        <field name="arch" type="xml">
            <form string="Contrato de Acopio">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <widget name="web_ribbon" title="Cancelado" bg_color="text-bg-danger" invisible="state != 'cancelled'"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,closed"/>
                    </div>
                    <group>
                        <group string="Información General">
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date"/>
                            <field name="deposit_type"/>
                            <field name="state"/>
                        </group>
                        <group string="Montos y Saldos" invisible="deposit_type == 'fixed_quantities'">
                            <field name="amount_total" invisible="deposit_type == 'fixed_quantities'"/>
                            <field name="amount_remaining" invisible="deposit_type == 'fixed_quantities'"/>
                            <field name="pricelist_id" invisible="deposit_type != 'fixed_pricelist'"/>
                            <field name="product_id" invisible="deposit_type != 'index_product'"/>
                            <field name="quantity_index" invisible="deposit_type != 'index_product'"/>
                            <field name="quantity_index_remaining" invisible="deposit_type != 'index_product'"/>
                        </group>
                    </group>
                        <group invisible="not advance_invoice_id">
                        <group>
                            <field name="advance_invoice_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Productos Acopiados" name="deposit_lines" invisible="deposit_type != 'fixed_quantities'">
                            <field name="deposit_line_ids">
                                <list create="1" delete="1" edit="1">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="quantity_remaining"/>
                                    <field name="product_uom_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Libro Mayor" name="ledger">
                            <field name="ledger_line_ids" readonly="1" nolabel="1">
                                <list decoration-muted="amount > 0" decoration-success="amount &lt; 0" create="0" delete="0" edit="0">
                                    <field name="date"/>
                                    <field name="move_type"/>
                                    <field name="amount"/>
                                    <field name="quantity"/>
                                    <field name="product_id"/>
                                    <field name="ref"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

</odoo>
