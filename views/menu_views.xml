<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Menú de configuración en Ajustes -->
    <record id="action_deposit_config_settings" model="ir.actions.act_window">
        <field name="name">Acopios</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'sale_customer_deposit'}</field>
    </record>
    <menuitem id="menu_deposit_config_settings"
              name="Acopios"
              parent="base.menu_config"
              action="action_deposit_config_settings"
              sequence="100"/>

    <!-- Menú principal bajo Ventas -->
    <record id="menu_deposit_contract_root" model="ir.ui.menu">
        <field name="name">Acopios</field>
        <field name="parent_id" ref="sale.sale_menu_root"/>
        <field name="sequence">50</field>
        <field name="action" ref="action_deposit_contract"/>
    </record>

    <!-- Acción: Lista de Contratos -->
    <record id="action_deposit_contract" model="ir.actions.act_window">
        <field name="name">Contratos de Acopio</field>
        <field name="res_model">deposit.contract</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear el primer contrato de acopio
            </p>
            <p>
                Un contrato de acopio permite al cliente pagar por adelantado y retirar
                materiales gradualmente. Los tipos soportados son: Lista de Precios Fija,
                Producto Índice y Cantidades Fijas.
            </p>
        </field>
    </record>

</odoo>
